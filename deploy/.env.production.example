# FormSathi production settings. Copy to /var/www/formsathi/shared/.env on
# the server (chmod 600) and fill in every value marked CHANGE.
# Never commit the real file: it holds the key that unlocks every user's data.

APP_NAME=FormSathi
APP_ENV=production
APP_DEBUG=false
# CHANGE: generate with `php artisan key:generate --show` (DEPLOY.md step 6).
# Losing this key means losing every user's papers. Keep a copy offline.
APP_KEY=
# CHANGE: your domain, with https.
APP_URL=https://formsathi.example.com
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=formsathi
DB_USERNAME=formsathi
# CHANGE: from /root/formsathi-db-password (created by server-setup.sh).
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Only if Cloudflare or a load balancer sits in front, e.g. its IP ranges, or *.
TRUSTED_PROXIES=

# AI for the assistant and job kit. Leave empty to run without AI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# bKash: start on the sandbox URL below; switch to the live base URL bKash
# gives you after onboarding (confirm it with them, don't guess it).
# The "fake" driver refuses to run in production.
BKASH_DRIVER=bkash
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

TESSERACT_PATH=/usr/bin/tesseract

# CHANGE: shown on every page and in SMS.
COMPANY_NAME=FormSathi
COMPANY_ADDRESS="Dhaka, Bangladesh"
COMPANY_HELPLINE="+880 1XXX-XXXXXX"

VITE_APP_NAME="${APP_NAME}"
