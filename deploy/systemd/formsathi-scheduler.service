# Laravel's scheduler: the daily passport/visa expiry SMS reminders (F3).
# Started every minute by formsathi-scheduler.timer.

[Unit]
Description=FormSathi scheduled tasks
After=network.target postgresql.service

[Service]
Type=oneshot
User=formsathi
Group=www-data
WorkingDirectory=/var/www/formsathi/current
ExecStart=/usr/bin/php /var/www/formsathi/current/artisan schedule:run
