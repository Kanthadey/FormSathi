# Background jobs: OCR of uploaded papers (F4).
# Restarted by deploy.sh after every release so it runs the new code.

[Unit]
Description=FormSathi queue worker
After=network.target postgresql.service

[Service]
User=formsathi
Group=www-data
WorkingDirectory=/var/www/formsathi/current
ExecStart=/usr/bin/php /var/www/formsathi/current/artisan queue:work --tries=1 --timeout=120 --max-time=3600 --sleep=3
Restart=always
RestartSec=5
# Decrypted papers exist only in temp files during OCR; keep them private.
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
